# Copy this file to .env and replace placeholders with real values.
# Never commit .env to source control.

# Public entry URL of the app under test (no hardcoded IPs in code).
BASE_URL=https://your-app.example.com/

# API base URL for API tests.
API_BASE_URL=https://your-api.example.com/

# UI login credentials for test user accounts only.
LOGIN_USERNAME=your_test_username
LOGIN_PASSWORD=your_test_password

# Optional token for API authorization.
API_TOKEN=your_api_token
API_AUTH_SCHEME=Bearer

# Keep artifacts disabled by default to avoid exposing sensitive data in files.
ENABLE_ARTIFACTS=false
